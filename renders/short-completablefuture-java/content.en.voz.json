        "    supplyAsync(() -> priceOf(id), pool);",
        "CompletableFuture<String> stock =",
        "    supplyAsync(() -> stockOf(id), pool);",
        "price.thenCombine(stock,",
        "    (p, s) -> p + \"+\" + s).join();"
