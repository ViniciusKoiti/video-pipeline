        "    supplyAsync(() -> precoDe(id), pool);",
        "CompletableFuture<String> estoque =",
        "    supplyAsync(() -> estoqueDe(id), pool);",
        "preco.thenCombine(estoque,",
        "    (p, e) -> p + \"+\" + e).join();"
