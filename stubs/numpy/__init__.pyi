from collections.abc import Sequence
from typing import Protocol

class ndarray:
    def __array__(self) -> ndarray: ...

class _ArrayLike(Protocol):
    def __array__(self) -> ndarray: ...

class float32: ...

def zeros(shape: int | tuple[int, ...], dtype: type[object] = ...) -> ndarray: ...
def concatenate(arrays: Sequence[_ArrayLike]) -> ndarray: ...
