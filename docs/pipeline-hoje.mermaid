flowchart TD
    %% Estado conferido em 2026-10-13. Ordem editorial recomendada, não um orquestrador automático.
    %% Verde: comando/script implementado. Azul: trabalho do agente. Laranja: decisão humana.
    %% Roxo: projeto/dependência externa. Cinza tracejado: etapa ainda incompleta.

    T["Dono define público, ângulo e objetivo"]:::dono --> PA["Agente escreve pauta.md; dono decide"]:::agente
    R["Projeto vizinho: radar-de-reels<br/>gera briefs/nicho.json; coleta somente quando autorizada"]:::externo
    R --> RC["radar_resumo.py copia brief disponível<br/>para radar-brief.json do episódio"]:::script
    RC --> PA
    RC -. "forma; nunca fonte de fato" .-> C2
    PA --> S1["baixar_fonte.py: fontes autorizadas<br/>sources.json + texto extraído"]:::script
    S1 --> S2["vp excerpts: trechos numerados"]:::cmd
    S2 --> F1["Agente pesquisador: facts.json<br/>evidências literais e lacunas"]:::agente
    F1 --> C1{"vp check: fontes e fichas"}:::cmd
    C1 -- "erro" --> F1
    C1 -- "ok" --> G1{{"Dono: gate sources<br/>vp approve/reject --step sources"}}:::gate
    G1 --> R1["Agente roteirista: outline.md e scenes.json<br/>narração + planos tipados"]:::agente
    R1 --> C2{"vp check: claims, âncoras, forma e objetivo"}:::cmd
    C2 -- "erro" --> R1
    C2 -- "ok" --> V1["Verificador independente: evidência e promessa"]:::agente
    V1 -- "pendência" --> R1
    V1 -- "conferido" --> G2{{"Dono: gate script antes da produção<br/>vp approve/reject --step script"}}:::gate
    G2 --> I1["Busca/download: scripts e revisão manual<br/>mídia + assets/id.json"]:::script
    I1 --> G3{{"Dono: direitos e ativos<br/>vp approve --step assets --asset id"}}:::gate
    G3 -- "trocar" --> I1
    G3 --> A1["montar_episodio.py: voz por cena<br/>Kokoro rascunho; Chatterbox final configurado<br/>Gemini continua opção"]:::script

    LAB["Projeto vizinho: lab-voz<br/>bancada histórica e ambiente Chatterbox"]:::externo
    LAB -. "quando CHATTERBOX_PYTHON aponta para seu ambiente" .-> W
    W["Adapter Chatterbox do auto-play<br/>executa seu chatterbox_worker.py<br/>com Python externo + referência local"]:::script
    W --> A1
    A1 --> A2["ffprobe: duração real do WAV<br/>episode_shots: âncoras proporcionais"]:::script
    A2 --> EP["Script monta episode.json"]:::script
    SUB["Alinhamento/geração de captions.srt<br/>adapter e comando subs ainda incompletos"]:::falta
    A2 -.-> SUB
    SUB -. "vínculo captions também falta no script" .-> EP
    EP --> M1["Adapter Remotion: render por cena<br/>cache e props da composição Scene"]:::script

    KIT["Pacote @viniciusk/motion-kit instalado<br/>SHA fixado em video/package.json"]:::externo
    CHECKOUT["Projeto vizinho: motion-kit<br/>fonte de desenvolvimento e consulta de API"]:::externo
    CHECKOUT -. "build e atualização do pin quando houver mudança" .-> KIT
    KIT --> M1
    M1 --> FINAL["ffmpeg assemble: vídeo das cenas<br/>+ narração dos WAVs"]:::script
    FINAL --> G4{{"Dono: prévia, legenda da postagem<br/>descrição, créditos e revisão final manual"}}:::gate
    G4 -- "ajustar texto; nova decisão" --> R1
    G4 -- "ajustar mídia" --> I1
    G4 --> U1["Publicação somente autorizada<br/>e coleta manual de métricas"]:::dono

    X["Ainda sem handlers: voice, subs, render, export, reopen<br/>scripts não impõem todos os gates/locks"]:::falta
    X -.-> A1
    X -.-> G4

    classDef cmd fill:#dff5e1,stroke:#2e7d32,color:#000
    classDef script fill:#e8f5e9,stroke:#66bb6a,color:#000
    classDef agente fill:#e3f2fd,stroke:#1976d2,color:#000
    classDef gate fill:#fff3e0,stroke:#ef6c00,color:#000
    classDef dono fill:#fff8e1,stroke:#f9a825,color:#000
    classDef externo fill:#ede7f6,stroke:#673ab7,color:#000
    classDef falta fill:#f5f5f5,stroke:#9e9e9e,stroke-dasharray:4 3,color:#000
