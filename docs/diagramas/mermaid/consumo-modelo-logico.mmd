erDiagram
    RUNS o|--o{ RUNS : origina
    RUNS ||--o{ REQUESTS : emite
    RUNS ||--o{ RESERVATIONS : compromete
    BUDGETS ||--o{ RESERVATIONS : recebe

    RUNS {
        text id PK
        text parent_run_id FK
        text project
        text episode_id
        text stage
        text session_id
        text agent_id
        text agent_name
        text status
        timestamp started_at
        timestamp finished_at
    }

    REQUESTS {
        text event_key PK
        text provider_request_id
        text run_id FK
        text model
        bigint input_tokens
        bigint output_tokens
        bigint cache_read_tokens
        bigint cache_write_tokens
        bigint cost_usd_micros
        bigint duration_ms
        text status
        timestamp occurred_at
    }

    BUDGETS {
        text id PK
        text project
        text episode_id
        text model_filter
        text metric
        bigint limit_value
        bigint spent_value
    }

    RESERVATIONS {
        text budget_id PK,FK
        text run_id PK,FK
        bigint initial_value
        bigint remaining_value
        text status
    }
