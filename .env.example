# Copie para .env e preencha. Nunca versione o .env.

# Texto local
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Provisório até o benchmark (etapa 5); alternativa menor: qwen3.5:4b
OLLAMA_MODEL=qwen3.5:9b

# Acervos e imagens
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# Coverr: sem chave; só clipes baixados à mão pelo site (ADR 007, emenda de bancos de imagem)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WORKERS_AI_MODEL=@cf/black-forest-labs/flux-1-schnell

# Dados
DATA_DIR=./data

# Limites de custo e cota (custo zero durante a validação)
MAX_API_SPEND_USD=0
ALLOW_PAID_API=false
MAX_GENERATED_IMAGES_PER_EPISODE=12
MAX_CANDIDATES_PER_SCENE=2
MAX_CLOUD_REQUESTS_PER_EPISODE=40

# Opcionais, só para comparação (etapa 28)
GROQ_API_KEY=
GEMINI_API_KEY=

# Voz clonada local (ADR 016, proposta). Caminhos desta máquina; a gravação é dado pessoal e fica fora do Git.
CHATTERBOX_PYTHON=
CHATTERBOX_REFERENCE=

# Postiz (agendamento das postagens; publicação só depois da revisão humana, §1)
# Chave: Postiz → Settings → Developers → Public API. URL: o backend da sua instalação (NEXT_PUBLIC_BACKEND_URL).
POSTIZ_API_KEY=
POSTIZ_API_URL=https://seu-postiz.exemplo.com/api

# reels-radar (ADR 018): pasta do projeto, de onde o resumo do nicho é copiado para o episódio.
RADAR_DIR=

# Quem assina as decisões dos gates (vp approve/reject); sem isso vale o git config user.name, com aviso
VP_REVIEWER=
