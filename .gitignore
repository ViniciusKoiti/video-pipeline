# Segredos e preferências locais
.env
CLAUDE.local.md

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Dados gerados (fixtures aprovadas vão em tests/fixtures/)
data/episodes/*
!data/episodes/.gitkeep
data/cache/*
!data/cache/.gitkeep
# Faixas de música, ativos e catálogo do dono (ADR 030): baixados à mão, fora do Git
data/music/*
# Consumo editorial privado, banco SQLite e arquivos auxiliares (ADR 032)
data/telemetry/

# Mídia pesada (exceto fixtures pequenas e revisadas)
*.mp4
*.wav
*.mp3
!tests/fixtures/episodes/*/voice/*.wav
data/benchmarks/renders/
data/benchmarks/estilo/
data/benchmarks/voz-pt/
data/benchmarks/voz-gemini/

# Node (somente se Remotion for escolhido)
node_modules/

# Índice exportado opcional do codebase-memory; o cache principal fica fora do repo.
.codebase-memory/

# Cookies exportados do navegador (credencial do dono, nunca no Git)
cookies.txt
*cookies*.txt

# Faixas da Biblioteca de áudio do YouTube: licença de uso em vídeo, não de redistribuição
MUSICAS/

# tabela gerada por scripts/provisorio/metricas.py tabela (os metrics.json são o registro)
data/publicacoes/metricas.csv

# cache do Remotion (Chrome headless de 200 MB)
.remotion/
data/sfx/*
